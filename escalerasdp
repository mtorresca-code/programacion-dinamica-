#include <iostream>
#include <vector>
using namespace std;
int main() {
    int n;
    cout << "Ingrese el numero de escalones (N): ";
    if (!(cin >> n) || n < 0) {
        cout << "Entrada invalida. Ingrese un numero entero no negativo." << endl;
        return 1;
    }
    vector<long long> dp(n + 1, 0);
    dp[0] = 1; 
    if (n >= 1) {
        dp[1] = 1;
    }
    for (int i = 2; i <= n; i++) {
        dp[i] = dp[i - 1] + dp[i - 2];
    }
    cout << "Formas posibles: " << dp[n] << endl;
    cout << "Tabla DP:" << endl;
    cout << "[";
    for (int i = 0; i <= n; i++) {
        cout << dp[i] << (i < n ? ", " : "");
    }
    cout << "]" << endl;
    return 0;
}
